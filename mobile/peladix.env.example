# Identidade nativa da Peladix. Não use o projectId nem o Firebase de outra pelada.
EXPO_APP_VARIANT=peladix
EXPO_APP_NAME=Peladix
EXPO_APP_SLUG=pelada-peladix
EXPO_APP_SCHEME=peladix
EXPO_ANDROID_PACKAGE=br.com.peladix.app
EXPO_ANDROID_VERSION_CODE=1
EXPO_IOS_BUNDLE_IDENTIFIER=br.com.peladix.app
EXPO_IOS_BUILD_NUMBER=1

# Projeto EAS exclusivo da Peladix.
EXPO_EAS_PROJECT_ID=4a4cf359-9c40-43b8-93bd-57a2ab53aa43
EXPO_OWNER=davidvegabr
EXPO_UPDATES_URL=https://u.expo.dev/4a4cf359-9c40-43b8-93bd-57a2ab53aa43

EXPO_PUBLIC_API_BASE_URL=https://peladix.vegaalameda.com
EXPO_PUBLIC_WEB_BASE_URL=https://peladix.vegaalameda.com
EXPO_PUBLIC_APP_ENV=preview

# Assets e configuração pública do Firebase fornecidos para a identidade da Peladix.
EXPO_APP_ICON=./assets/icon-peladix.png
EXPO_ADAPTIVE_ICON=./assets/adaptive-icon-peladix.png
EXPO_NOTIFICATION_ICON=./assets/notification-icon-peladix.png
EXPO_GOOGLE_SERVICES_FILE=./google-services-peladix.json
EXPO_PRIMARY_COLOR="#440052"
EXPO_ADAPTIVE_BACKGROUND_COLOR="#FFFFFF"
