# Imagem pronta publicada em um registry, se não quiser construir localmente.
APP_IMAGE=pelada-pede-mais-uma:latest
COMPOSE_PROJECT_NAME=pelada-pede-mais-uma
CONTAINER_NAME=pelada-pede-mais-uma

# Porta pública e porta interna do container.
HOST_PORT=3000
PORT=3000
CONTAINER_PORT=3000

# Versões reproduzíveis usadas no build.
NODE_VERSION=22.19.0
WRANGLER_VERSION=4.92.0
WORKERD_VERSION=1.20260515.1

# Nome do volume persistente (banco D1 local e uploads R2 locais).
DATA_VOLUME_NAME=pelada-pede-mais-uma-data
# No modelo do OMV, cada contrato deve apontar para uma pasta exclusiva.
INSTANCE_DATA_PATH=/srv/dev-disk-by-uuid/containers/pelada-pede-mais-uma
LOGGING_JOB_NAME=pelada-pede-mais-uma

# Observabilidade e recuperação de senha.
LOG_LEVEL=info
APP_BASE_URL=https://pelada.seudominio.com
WEATHER_GEOCODING_URL=https://nominatim.openstreetmap.org/search
WEATHER_FORECAST_URL=https://api.met.no/weatherapi/locationforecast/2.0/compact
WEATHER_FALLBACK_FORECAST_URL=https://api.open-meteo.com/v1/forecast
# Recomendado pela política do Nominatim para identificar a instância.
WEATHER_CONTACT_EMAIL=administrador@seudominio.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=peladapedemaisuma@gmail.com
SMTP_PASSWORD=senha-de-app-do-google
SMTP_FROM="Pelada Pede Mais Uma <peladapedemaisuma@gmail.com>"
