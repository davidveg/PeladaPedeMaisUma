# Copie este arquivo para cada grupo e altere todos os identificadores abaixo.
# O mesmo código/imagem pode atender várias instâncias; nunca compartilhe INSTANCE_DATA_PATH.
COMPOSE_PROJECT_NAME=pelada-nome-do-grupo
CONTAINER_NAME=pelada-nome-do-grupo
APP_IMAGE=pelada-pede-mais-uma:selfhost-arm64
HOST_PORT=3010
CONTAINER_PORT=3000
INSTANCE_DATA_PATH=/srv/dev-disk-by-uuid/containers/pelada-nome-do-grupo
LOGGING_JOB_NAME=pelada-nome-do-grupo

APP_BASE_URL=https://pelada-nome-do-grupo.seudominio.com
TZ=America/Sao_Paulo
LOG_LEVEL=info

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contato@seudominio.com
SMTP_PASSWORD=troque-por-um-segredo
SMTP_FROM="Nome da Pelada <contato@seudominio.com>"
