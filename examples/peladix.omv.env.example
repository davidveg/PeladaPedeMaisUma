# Instância independente da Peladix no OMV.
# Copie para o diretório do projeto Compose da Peladix, renomeie para .env
# e substitua todos os valores CHANGE_ME antes de executar o Compose.
COMPOSE_PROJECT_NAME=peladix
CONTAINER_NAME=peladix
APP_IMAGE=pelada-pede-mais-uma:selfhost-arm64
HOST_PORT=3020
CONTAINER_PORT=3000
INSTANCE_DATA_PATH=/srv/dev-disk-by-uuid/CHANGE_ME/containers/peladix
LOGGING_JOB_NAME=peladix

APP_BASE_URL=https://peladix.vegaalameda.com
TZ=America/Sao_Paulo
LOG_LEVEL=info

WEATHER_CONTACT_EMAIL=CHANGE_ME

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM="Peladix <CHANGE_ME>"
